# The engine needs these three variables; the optional ones below have defaults.
# See README.md > Self-host it. Terminal and website users do not need this file.

# Supabase project URL (Project Settings > Data API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key, used only to verify sign-in tokens.
SUPABASE_KEY=your-publishable-key

# Postgres connection string for the postgres user: the direct connection or the
# session pooler (port 5432). The engine switches to the authenticated role per request.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Optional. Model calls allowed per user per day (default 100).
# WMN_DAILY_MODEL_CALLS=100
# Optional. The timezone "today" and "yesterday" are read in (default UTC).
# WMN_TIMEZONE=Asia/Kolkata
# Optional. Set to 1 to let a model address point at a private host, such as a
# local model server. Leave unset on any shared deployment.
# WMN_ALLOW_PRIVATE_MODEL_HOSTS=1

# There is no server-side model key: each person sends their own with each
# request (X-Model-Key, with optional X-Model-Base-URL and X-Model-Name).
