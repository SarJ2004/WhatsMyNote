# --- Engine configuration ---
# Required for running the engine locally for development.
# Note: PyPI users do NOT need this file!

SUPABASE_URL=https://...supabase.co
SUPABASE_KEY=eyJhb...

# The Postgres the engine connects to. It switches to the `authenticated` role
# inside every transaction, so row-level security applies to each request.
DATABASE_URL=postgresql://...

# Optional. Model calls allowed per user per day (default 100).
# WMN_DAILY_MODEL_CALLS=100
# Optional. The timezone "today" and "yesterday" are read in (default UTC).
# WMN_TIMEZONE=Asia/Kolkata
# Optional. Set to 1 to let a model address point at a private host, such as a
# local model server. Leave unset on any shared deployment.
# WMN_ALLOW_PRIVATE_MODEL_HOSTS=1

# There is no server-side model key: each person sends their own with each
# request (X-Model-Key, with optional X-Model-Base-URL and X-Model-Name).
