# The engine reads exactly these three variables. See README.md > Self-host it.
# Terminal and website users do not need this file.

# Supabase project URL (Project Settings > Data API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key, used only to verify sign-in tokens.
SUPABASE_KEY=your-publishable-key

# Postgres connection string for the postgres user: the direct connection or the
# session pooler (port 5432). The engine switches to the authenticated role per request.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
